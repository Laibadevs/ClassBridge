# PostgreSQL connection string. Use psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://classbridge:classbridge@localhost:5432/classbridge

# Long random string used to sign CSRF tokens. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# How long a login session lasts before it must be renewed.
SESSION_EXPIRE_MINUTES=10080

# How long a password-reset link stays valid.
RESET_TOKEN_EXPIRE_MINUTES=30

# Exact origin of the Next.js frontend (no trailing slash). Used for CORS —
# never combine allow_origins=["*"] with credentialed (cookie) auth.
FRONTEND_URL=http://localhost:3000

# development | production. Controls the Secure flag on cookies:
# development allows plain http://localhost, production requires HTTPS.
ENVIRONMENT=development

# AI provider for parent-update generation: mock | openai | gemini
# "mock" (default) needs no key and works fully offline/for tests.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# WhatsApp Business Cloud API (Phase 5) — backend-only, never sent to the
# frontend. Leave WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID empty to
# use the built-in mock provider (default, and what tests run against) —
# nothing is sent over the network until both are set. See
# docs/whatsapp-setup.md for how to obtain real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Verifies Meta's webhook: the GET handshake must echo hub.challenge only
# when hub.verify_token matches this value; the POST body's
# X-Hub-Signature-256 header is checked against WHATSAPP_APP_SECRET when set.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional: only usable once this exact name/language has been created and
# approved in Meta Business Manager.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Safety cap on recipients resolved for a single announcement send.
WHATSAPP_MAX_RECIPIENTS=100
